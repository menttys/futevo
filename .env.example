# Copy to .env and fill in with values from the Firebase console.
# EXPO_PUBLIC_ vars are inlined into the app bundle at build time.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<client-id>.apps.googleusercontent.com

# Web build only: Firebase web app config (Firebase console > Project settings > Your apps > Web).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
